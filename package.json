{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "migrate:up": "bun src/infra/db/migrate.ts up",
    "migrate:down": "bun src/infra/db/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:load": "bun load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1176.0",
    "@mikro-orm/core": "6.6.19",
    "@mikro-orm/migrations": "6.6.19",
    "@mikro-orm/postgresql": "6.6.19",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}